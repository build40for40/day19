{
  "name": "gobbler",
  "version": "0.0.0",
  "private": true,
  "description": "Gobbler, Day 19 of 40 for 40: five contacts a day, delete or keep with gratitude, as an MCP App.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:widget && npm run wrangler -- dev --port 8799",
    "build:widget": "vite build",
    "build": "npm run build:widget && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p widget",
    "test": "vitest run",
    "deploy": "npm run build:widget && npm run wrangler -- deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "host": "vite --config vite.host.config.ts",
    "widget": "vite --config vite.config.ts --port 5198 --open '/widget.html?fake=1'"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.11",
    "typescript": "~6.0.0",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
