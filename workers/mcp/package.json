{
  "name": "@day19/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "The Day 19 Worker: the MCP server and its widget, Google sign-in, and each person's Brain.",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:widget && pnpm wrangler dev",
    "build:widget": "vite build",
    "build": "pnpm build:widget && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p widget",
    "test": "pnpm build:widget && vitest run",
    "deploy": "pnpm build:widget && pnpm wrangler deploy",
    "types": "wrangler types --env-interface Env",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "host": "vite --config vite.host.config.ts",
    "widget": "vite --config vite.config.ts --port 5198 --open '/widget.html?fake=1'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/workers-oauth-provider": "1.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@modelcontextprotocol/client": "2.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
