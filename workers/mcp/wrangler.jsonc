{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day19",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  // agents/mcp/server uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // The widget is one built HTML file (dist/widget.html), bundled into the Worker as text.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // The URL MCP clients connect to. Every token is bound to it, and its host serves sign-in,
  // discovery, the landing page and /privacy. Requests to any other host redirect there (src/hosts.ts).
  // Local dev overrides it in .dev.vars with http://localhost:8788/mcp.
  "vars": {
    "MCP_RESOURCE": "https://gobbler.build40for40.com/mcp"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },

  // Sign-in state: registered clients, grants and tokens (hashed), consent handles.
  // Wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  // The Brain: one Durable Object per Google account, plus one shared by the demo.
  "durable_objects": {
    "bindings": [{ "name": "BRAINS", "class_name": "Brain" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Brain"] }],

  // Ben's landing page. landing/index.html is served at /, with any CSS and images next to it.
  // The Worker runs first, so /mcp, /authorize, /callback, /privacy and /oauth/* always reach it:
  // don't add files with those names here.
  "assets": { "directory": "./landing", "binding": "ASSETS", "run_worker_first": true },

  // The Google redirect URIs are https://gobbler.build40for40.com/callback, and
  // http://localhost:8788/callback for local dev.
  "dev": { "port": 8788 },

  "routes": [
    // The app's own host, matching MCP_RESOURCE. Deploying creates the custom domain and its DNS record.
    { "pattern": "gobbler.build40for40.com", "custom_domain": true },
    // The site's usual build40for40.com/<app>/ address, which redirects to the subdomain.
    { "pattern": "build40for40.com/gobbler", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/gobbler/*", "zone_name": "build40for40.com" }
  ],
  // The old workers.dev address stays on, and redirects to the subdomain.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
